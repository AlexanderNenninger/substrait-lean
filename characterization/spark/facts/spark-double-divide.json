      "group": "fp.div",
      "option": "on_division_by_zero",
      "types": [
        "fp32",
        "fp64"
      ]
    },
    {
      "group": "fp.div",
      "option": "nan_creation",
      "types": [
        "fp32",
        "fp64"
      ]
    },
    {
