{
  "id": "spark-double-divide",
  "engine": "spark",
  "engine_version": "4.3.0",
  "title": "Double `/`: a zero divisor raises (ANSI) or gives NULL, never inf",
  "verdict": "`on_division_by_zero`: `ERROR` (ANSI) or `NULL`; `inf / inf` NaN; overflow `±inf`",
  "area": "doubles",
  "options": [
    "on_division_by_zero",
    "nan_creation",
    "on_domain_error",
    "float_overflow",
    "rounding"
  ],
  "rows": [
