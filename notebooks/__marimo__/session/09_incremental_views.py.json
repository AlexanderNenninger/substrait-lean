    {
      "id": "Vxnm",
      "code_hash": "9d48ed0c98a5514df4e70eeb721c53f2",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Customer changes: insert <strong>cy (Lima)</strong>, delete <strong>bob (Oslo)</strong>. Order changes: as selected above.</span></span><div style='display: flex;flex: 1;flex-direction: row;justify-content: flex-start;align-items: normal;flex-wrap: wrap;gap: 2rem'><div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>incremental (old join + delta)</strong></span></span><table style='border-collapse:collapse;font-size:0.9rem;width:auto;margin:0'><thead><tr><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>id</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>customer</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>amount</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>name</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>city</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>weight</th></tr></thead><tbody><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>3</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>ada</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>ada</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>Paris</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;color:#2e8b57;font-weight:600'>+1</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>4</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>cy</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>50</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>cy</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>Lima</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;color:#2e8b57;font-weight:600'>+1</td></tr></tbody></table></div><div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>recomputed from scratch</strong></span></span><table style='border-collapse:collapse;font-size:0.9rem;width:auto;margin:0'><thead><tr><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>id</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>customer</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>amount</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>name</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>city</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>weight</th></tr></thead><tbody><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>3</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>ada</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>ada</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>Paris</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;color:#2e8b57;font-weight:600'>+1</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>4</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>cy</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>50</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>cy</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>Lima</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;color:#2e8b57;font-weight:600'>+1</td></tr></tbody></table></div></div><marimo-callout-output data-html='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eEqual \u2713&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;success&quot;'></marimo-callout-output></div>"
          }
        }
      ],
      "console": []
