          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><code>orders.apply(sv.Changes(inserts=[...], deletes=[...]))</code> changes a\nsource and gives it a new version; the next <code>view.refresh()</code> gets\nexactly that change and updates the view from it. To check, we build\nthe same node again and refresh it: a node that has never been\nrefreshed computes its result from scratch. We'll throw some changes at\nit: press the button to change both tables at once, at random.</span></span>"
          }
        }
      ],
      "console": []
