            "text/html": "<span class=\"markdown prose dark:prose-invert contents\"><table>\n<thead>\n<tr>\n<th>postcondition</th>\n<th>status</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>unique(device, ts)</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td><code>(_.ts_right.isnull() | (_.ts_right &lt;= _.ts))</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td><code>ts_right IS NULL OR ts_right &gt;= ts - INTERVAL '10 milliseconds'</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td>runtime</td>\n<td>\u26a0\ufe0f may wrap around: ($1 - 10000)</td>\n</tr>\n<tr>\n<td>runtime</td>\n<td>\u26a0\ufe0f may wrap around: ($6 - 1)</td>\n</tr>\n</tbody>\n</table>\n<table>\n<thead>\n<tr>\n<th>output column</th>\n<th>known values</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>device</code></td>\n<td>any integer</td>\n</tr>\n<tr>\n<td><code>ts</code></td>\n<td>any timestamp</td>\n</tr>\n<tr>\n<td><code>a</code></td>\n<td>any double or NULL</td>\n</tr>\n<tr>\n<td><code>ts_right</code></td>\n<td>any timestamp or NULL</td>\n</tr>\n<tr>\n<td><code>g</code></td>\n<td>any double or NULL</td>\n</tr>\n</tbody>\n</table></span>"
