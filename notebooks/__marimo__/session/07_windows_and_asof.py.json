16px 4px 0;white-space:nowrap'>2024-05-01 07:07</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>1.2</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2024-05-01 07:05</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>b</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2024-05-01 07:01</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>9.0</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>8.5</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>0</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>b</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2024-05-01 07:04</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>8.5</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2024-05-01 07:01</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>1</td></tr></tbody></table></div>"
