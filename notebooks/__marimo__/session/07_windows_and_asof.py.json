    {
      "id": "SFPL",
      "code_hash": "4a1981e497887236b6b9afd9e4b11428",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><code>report.deterministic</code> is <strong>True</strong></span></span><span class=\"markdown prose dark:prose-invert contents\"><table>\n<thead>\n<tr>\n<th>postcondition</th>\n<th>status</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>(_.prev_ts.isnull() | (_.prev_ts &lt; _.ts))</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td><code>(_.rn &gt;= 0)</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td>runtime</td>\n<td>\u26a0\ufe0f may wrap around: ($5 - 1)</td>\n</tr>\n</tbody>\n</table>\n<table>\n<thead>\n<tr>\n<th>output column</th>\n<th>known values</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>sensor</code></td>\n<td>a string</td>\n</tr>\n<tr>\n<td><code>ts</code></td>\n<td>any timestamp</td>\n</tr>\n<tr>\n<td><code>v</code></td>\n<td>any double or NULL</td>\n</tr>\n<tr>\n<td><code>prev_ts</code></td>\n<td>any timestamp or NULL</td>\n</tr>\n<tr>\n<td><code>next_v</code></td>\n<td>any double or NULL</td>\n</tr>\n<tr>\n<td><code>rn</code></td>\n<td>an integer \u2265 0</td>\n</tr>\n</tbody>\n</table></span></div>"
          }
        }
