          "type": "data",
          "data": {
            "text/html": "<span class=\"markdown prose dark:prose-invert contents\"><table>\n<thead>\n<tr>\n<th>postcondition</th>\n<th>status</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>~_.v.isnan()</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td><code>(_.scaled &gt;= 0)</code></td>\n<td>\u274c TRUE or FALSE</td>\n</tr>\n<tr>\n<td><code>(_.rounded &gt;= 0)</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td><code>(_.rounded &lt;= 1)</code></td>\n<td>\u2705 proved</td>\n</tr>\n</tbody>\n</table>\n<table>\n<thead>\n<tr>\n<th>output column</th>\n<th>known values</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>v</code></td>\n<td>a double \u2265 0.0 and \u2264 1.0</td>\n</tr>\n<tr>\n<td><code>scaled</code></td>\n<td>any double</td>\n</tr>\n<tr>\n<td><code>rounded</code></td>\n<td>an integer in [0, 1]</td>\n</tr>\n</tbody>\n</table></span>"
          }
