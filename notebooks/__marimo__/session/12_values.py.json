            "text/html": "<span class=\"markdown prose dark:prose-invert contents\"><table>\n<thead>\n<tr>\n<th>postcondition</th>\n<th>status</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>(_.n &gt;= 0)</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td><code>_.shout.notnull()</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td>runtime</td>\n<td>\u274c may fail: invalid regular expression: REGEXP_MATCH_\"(a|b)\\1\"($0)</td>\n</tr>\n</tbody>\n</table>\n<table>\n<thead>\n<tr>\n<th>output column</th>\n<th>known values</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>n</code></td>\n<td>an integer \u2265 0</td>\n</tr>\n<tr>\n<td><code>shout</code></td>\n<td>a string</td>\n</tr>\n<tr>\n<td><code>has_digits</code></td>\n<td>TRUE or FALSE</td>\n</tr>\n<tr>\n<td><code>repeated</code></td>\n<td>TRUE or FALSE</td>\n</tr>\n</tbody>\n</table></span>"
