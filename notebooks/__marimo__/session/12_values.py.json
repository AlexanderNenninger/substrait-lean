            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>the table's doubles, as the model has them</strong></span></span><table style='border-collapse:collapse;font-size:0.9rem;width:auto;margin:0'><thead><tr><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>v</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>positive</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>equals_nan</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>below_inf</th></tr></thead><tbody><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>-9999.0</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>true</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>-1.0</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>true</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>0.0</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>true</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>0.0</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>true</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>1.5</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>true</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>true</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>inf</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>true</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>NaN</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>true</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>true</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>false</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td></tr></tbody></table></div>"
