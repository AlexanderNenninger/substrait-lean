          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><table>\n<thead>\n<tr>\n<th>postcondition</th>\n<th>status</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>(_.bpm &gt;= 30)</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td><code>(_.bpm &lt;= 230)</code></td>\n<td>\u2705 proved</td>\n</tr>\n<tr>\n<td><code>~_.bpm.isnan()</code></td>\n<td>\u2705 proved</td>\n</tr>\n</tbody>\n</table>\n<table>\n<thead>\n<tr>\n<th>output column</th>\n<th>known values</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>user_id</code></td>\n<td>any integer</td>\n</tr>\n<tr>\n<td><code>kind</code></td>\n<td>a string or NULL</td>\n</tr>\n<tr>\n<td><code>ts</code></td>\n<td>any timestamp</td>\n</tr>\n<tr>\n<td><code>bpm</code></td>\n<td>a double \u2265 30.0 and \u2264 230.0</td>\n</tr>\n<tr>\n<td><code>start</code></td>\n<td>any timestamp</td>\n</tr>\n<tr>\n<td><code>end</code></td>\n<td>any timestamp</td>\n</tr>\n</tbody>\n</table></span>"
