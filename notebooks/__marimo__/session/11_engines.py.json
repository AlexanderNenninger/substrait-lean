n:left;padding:4px 16px 4px 0;white-space:nowrap'>a</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>7</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>alpha</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>b</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>-7</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>beta</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>a</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>9223372036854775807</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>alpha</td></tr></tbody></table></div><div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>duckdb</strong></span></span><table style='border-collapse:collapse;font-size:0.9rem;width:auto;margin:0'><thead><tr><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>k</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>qty</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>label</th></tr></thead><tbody><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>a</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>7</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>alpha</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>b</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>-7</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>beta</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>a</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>9223372036854775807</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>alpha</td></tr></tbody></table></div><div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>polars</strong></span></span><table style='border-collapse:collapse;font-size:0.9rem;width:auto;margin:0'><thead><tr><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>k</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>qty</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>label</th></tr></thead><tbody><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>a</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>7</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>alpha</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>b</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>-7</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>beta</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>a</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>9223372036854775807</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>alpha</td></tr></tbody></table></div><div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>datafusion</strong></span></span><table style='border-collapse:collapse;font-size:0.9rem;width:auto;margin:0'><thead><tr><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>k</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>qty</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>label</th></tr></thead><tbody><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>a</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>7</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>alpha</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>a</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>9223372036854775807</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>alpha</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>b</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>-7</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>beta</td></tr></tbody></table></div></div><marimo-callout-output data-html='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eAll three engines agree \u2713&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;success&quot;'></marimo-callout-output></div>"
