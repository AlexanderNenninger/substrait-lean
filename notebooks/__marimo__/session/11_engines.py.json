            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><div class=\"language-sql codehilite\"><pre><span></span><code><span class=\"k\">SELECT</span>\n<span class=\"w\">  </span><span class=\"n\">s1</span><span class=\"p\">.</span><span class=\"ss\">\"c0\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"k\"</span><span class=\"p\">,</span>\n<span class=\"w\">  </span><span class=\"n\">s1</span><span class=\"p\">.</span><span class=\"ss\">\"c1\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"doubled\"</span>\n<span class=\"k\">FROM</span><span class=\"w\"> </span><span class=\"p\">(</span>\n<span class=\"w\">  </span><span class=\"k\">SELECT</span>\n<span class=\"w\">    </span><span class=\"n\">s2</span><span class=\"p\">.</span><span class=\"ss\">\"c3\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c0\"</span><span class=\"p\">,</span>\n<span class=\"w\">    </span><span class=\"n\">s2</span><span class=\"p\">.</span><span class=\"ss\">\"c4\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c1\"</span>\n<span class=\"w\">  </span><span class=\"k\">FROM</span><span class=\"w\"> </span><span class=\"p\">(</span>\n<span class=\"w\">    </span><span class=\"k\">SELECT</span>\n<span class=\"w\">      </span><span class=\"n\">s3</span><span class=\"p\">.</span><span class=\"ss\">\"c0\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c0\"</span><span class=\"p\">,</span>\n<span class=\"w\">      </span><span class=\"n\">s3</span><span class=\"p\">.</span><span class=\"ss\">\"c1\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c1\"</span><span class=\"p\">,</span>\n<span class=\"w\">      </span><span class=\"n\">s3</span><span class=\"p\">.</span><span class=\"ss\">\"c2\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c2\"</span><span class=\"p\">,</span>\n<span class=\"w\">      </span><span class=\"n\">s3</span><span class=\"p\">.</span><span class=\"ss\">\"c0\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c3\"</span><span class=\"p\">,</span>\n<span class=\"w\">      </span><span class=\"p\">(</span>\n<span class=\"w\">        </span><span class=\"k\">CAST</span><span class=\"p\">(</span><span class=\"n\">s3</span><span class=\"p\">.</span><span class=\"ss\">\"c1\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"nb\">BIGINT</span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"o\">*</span><span class=\"w\"> </span><span class=\"k\">CAST</span><span class=\"p\">(</span><span class=\"mi\">2</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"nb\">BIGINT</span><span class=\"p\">)</span>\n<span class=\"w\">      </span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c4\"</span>\n<span class=\"w\">    </span><span class=\"k\">FROM</span><span class=\"w\"> </span><span class=\"p\">(</span>\n<span class=\"w\">      </span><span class=\"k\">SELECT</span>\n<span class=\"w\">        </span><span class=\"n\">s4</span><span class=\"p\">.</span><span class=\"ss\">\"c0\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c0\"</span><span class=\"p\">,</span>\n<span class=\"w\">        </span><span class=\"n\">s4</span><span class=\"p\">.</span><span class=\"ss\">\"c1\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c1\"</span><span class=\"p\">,</span>\n<span class=\"w\">        </span><span class=\"n\">s4</span><span class=\"p\">.</span><span class=\"ss\">\"c2\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c2\"</span>\n<span class=\"w\">      </span><span class=\"k\">FROM</span><span class=\"w\"> </span><span class=\"p\">(</span>\n<span class=\"w\">        </span><span class=\"k\">SELECT</span>\n<span class=\"w\">          </span><span class=\"ss\">\"k\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c0\"</span><span class=\"p\">,</span>\n<span class=\"w\">          </span><span class=\"ss\">\"qty\"</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c1\"</span><span class=\"p\">,</span>\n<span class=\"w\">          </span><span class=\"p\">(</span>\n<span class=\"w\">            </span><span class=\"ss\">\"v\"</span><span class=\"w\"> </span><span class=\"o\">+</span><span class=\"w\"> </span><span class=\"k\">CAST</span><span class=\"p\">(</span><span class=\"s1\">'0'</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"n\">DOUBLE</span><span class=\"p\">)</span>\n<span class=\"w\">          </span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"ss\">\"c2\"</span>\n<span class=\"w\">        </span><span class=\"k\">FROM</span><span class=\"w\"> </span><span class=\"ss\">\"t\"</span>\n<span class=\"w\">      </span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"n\">s4</span>\n<span class=\"w\">      </span><span class=\"k\">WHERE</span>\n<span class=\"w\">        </span><span class=\"p\">(</span>\n<span class=\"w\">          </span><span class=\"p\">(</span>\n<span class=\"w\">            </span><span class=\"k\">CAST</span><span class=\"p\">(</span><span class=\"mi\">0</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"nb\">BIGINT</span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"o\">&lt;</span><span class=\"w\"> </span><span class=\"n\">s4</span><span class=\"p\">.</span><span class=\"ss\">\"c1\"</span>\n<span class=\"w\">          </span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">IS</span><span class=\"w\"> </span><span class=\"k\">TRUE</span>\n<span class=\"w\">        </span><span class=\"p\">)</span>\n<span class=\"w\">    </span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"n\">s3</span>\n<span class=\"w\">  </span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"n\">s2</span>\n<span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"n\">s1</span>\n</code></pre></div></span>"
