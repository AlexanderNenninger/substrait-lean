    {
      "id": "PKri",
      "code_hash": "0250b69cc5180b9d5376432398b62e54",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>transactions (Delta, version 0 + constraint = v1)</strong></span></span><table style='border-collapse:collapse;font-size:0.9rem;width:auto;margin:0'><thead><tr><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>txn_id</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>card_id</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>merchant</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>amount_cents</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>ts</th></tr></thead><tbody><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>1</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>10</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>coffee</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>450</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2026-03-02 08:00</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>10</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>coffee</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>450</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2026-03-02 08:02</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>3</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>11</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>books</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2599</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2026-03-02 09:00</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>4</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>11</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>books</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2599</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2026-03-02 09:30</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>5</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>12</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>999</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2026-03-02 10:00</td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>6</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>12</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap;opacity:.5'>NULL</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>999</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>2026-03-02 10:01</td></tr></tbody></table></div>"
          }
        }
      ],
      "console": []
