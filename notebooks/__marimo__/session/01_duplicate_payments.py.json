          "type": "data",
          "data": {
            "text/plain": ""
          }
        }
      ],
      "console": [
        {
          "type": "stream",
          "name": "stdout",
          "text": "duplicate_payments:\n  computed\n  requires transactions: unique(txn_id) (checked on data)\n  requires transactions: (_.amount_cents >= 0) (Delta constraint)\n  requires transactions: (_.ts < datetime.datetime(2100, 1, 1, 0, 0)) (file stats @v3)\n  wrote duplicate_payments from transactions@v3: created v2, 1 row(s) written, 0 deleted\nduplicate_payments:\n  transactions@v3: no new version\n  view duplicate_payments: transactions@v3\n  wrote duplicate_payments from transactions@v3: already committed (v2)\n",
          "mimetype": "text/plain"
        }
      ]
