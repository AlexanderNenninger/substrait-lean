    {
      "id": "DnEU",
      "code_hash": "d72d7707038647fee98d308965f0329a",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">For a warehouse, sverify writes the plan as SQL. The SQL is long because\nit spells out every choice an engine would otherwise make. The Spark\nSQL is what <code>engine=\"spark\"</code> runs, and the Snowflake SQL runs in your\naccount, from the written SQL\n(<a href=\"https://github.com/AlexanderNenninger/substrait-lean/blob/main/docs/stability.md#engines\" rel=\"noopener noreferrer\" target=\"_blank\">the engines</a>):</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "ulZA",
      "code_hash": "936f437bb73d2c4acd3f41919378da4f",
      "outputs": [
        {
