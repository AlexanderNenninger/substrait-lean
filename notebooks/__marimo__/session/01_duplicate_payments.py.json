>\n<span class=\"w\">          </span><span class=\"k\">AND</span><span class=\"w\"> </span><span class=\"p\">(</span>\n<span class=\"w\">            </span><span class=\"k\">NOT</span><span class=\"w\"> </span><span class=\"p\">(</span>\n<span class=\"w\">              </span><span class=\"n\">s4</span><span class=\"p\">.</span><span class=\"ss\">\"c4\"</span><span class=\"w\"> </span><span class=\"o\">&lt;</span><span class=\"w\"> </span><span class=\"n\">s3</span><span class=\"p\">.</span><span class=\"ss\">\"c4\"</span>\n<span class=\"w\">            </span><span class=\"p\">)</span>\n<span class=\"w\">          </span><span class=\"p\">)</span>\n<span class=\"w\">        </span><span class=\"p\">)</span>\n<span class=\"w\">        </span><span class=\"k\">AND</span><span class=\"w\"> </span><span class=\"p\">(</span>\n<span class=\"w\">          </span><span class=\"k\">NOT</span><span class=\"w\"> </span><span class=\"p\">(</span>\n<span class=\"w\">            </span><span class=\"n\">DATEADD</span><span class=\"p\">(</span><span class=\"n\">MICROSECOND</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"mi\">300000000</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"n\">s3</span><span class=\"p\">.</span><span class=\"ss\">\"c4\"</span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"o\">&lt;</span><span class=\"w\"> </span><span class=\"n\">s4</span><span class=\"p\">.</span><span class=\"ss\">\"c4\"</span>\n<span class=\"w\">          </span><span class=\"p\">)</span>\n<span class=\"w\">        </span><span class=\"p\">)</span>\n<span class=\"w\">      </span><span class=\"p\">)</span>\n<span class=\"w\">  </span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"n\">s2</span>\n<span class=\"p\">)</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"n\">s1</span>\n</code></pre></div></span>"
