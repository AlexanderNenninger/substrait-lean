            "text/html": "<pre class='text-xs'>Contract(node=&#x27;duplicate_payments&#x27;, plan=&#x27;07757e24e7d440d253a1a02538d68f51cefdd802c816af505cc897383bc18ed7&#x27;, sources={&#x27;transactions&#x27;: 3}, epoch=3, not_null=[&#x27;merchant&#x27;, &#x27;first_txn&#x27;, &#x27;duplicate_txn&#x27;, &#x27;card_id&#x27;, &#x27;amount_cents&#x27;, &#x27;first_ts&#x27;, &#x27;duplicate_ts&#x27;], checks={&#x27;sverify_1&#x27;: &#x27;first_txn &lt; duplicate_txn&#x27;, &#x27;sverify_2&#x27;: &#x27;amount_cents &gt;= 0&#x27;, &#x27;sverify_3&#x27;: &#x27;first_ts &lt;= duplicate_ts&#x27;}, unique=[[&#x27;first_txn&#x27;, &#x27;duplicate_txn&#x27;]], digests={}, cursors={}, table_ids={&#x27;transactions&#x27;: &#x27;b497ad56-668c-4c0c-93e2-a4c670601657&#x27;}, format=2)</pre>"
