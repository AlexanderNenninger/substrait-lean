            "text/plain": ""
          }
        }
      ],
      "console": []
    },
    {
      "id": "BYtC",
      "code_hash": "4933cee755361bf02a5ca1f56c627c20",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Now we build it. The Delta table is a source, and piping it into the\nrule builds a node. Building the node proves the contract (a\n<code>VerificationError</code> would stop here), and its first refresh loads the\ncurrent snapshot:</span></span>"
          }
        }
      ],
      "console": []
    },
