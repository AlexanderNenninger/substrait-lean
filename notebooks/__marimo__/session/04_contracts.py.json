    {
      "id": "Hstk",
      "code_hash": "d0e6413c16c994c4dbac741dd76531c0",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<marimo-callout-output data-html='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003e&#92;u003cstrong&#92;u003ePostconditionError&#92;u003c/strong&#92;u003e: 1 output row(s) violate (_.amount &amp;lt; 100)&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;danger&quot;'></marimo-callout-output>"
          }
