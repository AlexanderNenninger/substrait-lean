    {
      "id": "Xref",
      "code_hash": "2e6dd2d1299576d7d4bc63378fccd83d",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><table style='border-collapse:collapse;font-size:0.9rem;width:auto;margin:0'><thead><tr><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>step</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>what Lean knows about amount</th><th style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>\u2026 about doubled</th></tr></thead><tbody><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>orders (input)</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>an integer \u2265 0</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'></td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>after filter amount > 10</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>an integer \u2265 11</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'></td></tr><tr><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>doubled = amount \u00d7 2</td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'></td><td style='text-align:left;padding:4px 16px 4px 0;white-space:nowrap'>an integer \u2265 22</td></tr></tbody></table><marimo-callout-output data-html='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003e&#92;u003ccode&#92;u003edoubled &amp;gt;= 20&#92;u003c/code&#92;u003e is &#92;u003cstrong&#92;u003eproved&#92;u003c/strong&#92;u003e \u2713&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;success&quot;'></marimo-callout-output></div>"
          }
        }
