import SubstraitLean.Profile

/-!
# Lowerings: a table of proved templates (#241)

A **lowering** to an engine says, for each function of the model, how to
write it so that the engine, run under its profile `p`, gives the reference's
outcome. Each entry is a **template**: an expression over the function's
arguments, as fields `0`, `1`, …, built from functions the engine runs. A
template carries two proofs:

* `agree`: on every argument value, the template under `p` has the reference
  outcome of the function: the same value, or an error;
* `strict`: the template always reads each argument (`Expr.must`), so an
  argument that raises makes the template raise, as it makes the function
  raise in the reference.

The entries are generated by a metaprogram (`SubstraitLean/LoweringSearch.lean`)
and checked by the kernel like any declaration. This file proves, once for
every table, that lowering an expression with it is correct
(`Lowering.lower_correct`, `Lowering.lower_exact`), and lowering a plan
(`Lowering.lowerRel_sound`), by `Rel.evalI_mapExprs`.
-/

namespace Substrait

/-- The fields evaluating `t` always reads, unless an earlier part raises: a
`CASE` reads its condition's, and those both branches read. -/
def Expr.must : Expr → List Nat
  | .lit _ => []
  | .field i => [i]
  | .un _ a => a.must
  | .bin _ a b => a.must ++ b.must
  | .ifThen c t e => c.must ++ t.must.filter (· ∈ e.must)
  | .hof _ l _ => l.must

/-- Substituting expressions that evaluate to `vs` is evaluating on `vs`. -/
theorem Expr.evalP_subst {p : Profile} {row : Row} {σ : List Expr} {vs : List Value}
    (hσ : ∀ i, (σ.getD i (.lit .null)).evalP p row = .ok (vs.getD i .null)) :
    ∀ t : Expr, (t.subst σ).evalP p row = t.evalP p vs
  | .lit _ => rfl
  | .field i => hσ i
  | .un f a => by simp only [subst, evalP, evalP_subst hσ a]
  | .bin f a b => by simp only [subst, evalP, evalP_subst hσ a, evalP_subst hσ b]
  | .ifThen c t e => by simp only [subst, evalP, evalP_subst hσ c, evalP_subst hσ t, evalP_subst hσ e]
  | .hof f l b => by simp only [subst, evalP, evalP_subst hσ l]

theorem Outcome.bind_error {o : Outcome} {g : Value → Outcome} (h : o.err?.isSome) :
    Outcome.err? (o >>= g) |>.isSome := by
  cases o <;> simp_all [Outcome.err?] <;> rfl

theorem Outcome.ok_bind {x : Value} {g : Value → Outcome} : (Except.ok x >>= g : Outcome) = g x := rfl

/-- A template raises when an argument it always reads raises. -/
theorem Expr.subst_raises {p : Profile} {row : Row} {σ : List Expr} {i : Nat}
    (hi : ((σ.getD i (.lit .null)).evalP p row).err?.isSome) :
    ∀ t : Expr, i ∈ t.must → ((t.subst σ).evalP p row).err?.isSome
  | .lit _, h => by simp [must] at h
  | .field j, h => by simp only [must, List.mem_singleton] at h; subst h; exact hi
  | .un f a, h => by
    simp only [subst, evalP]; exact Outcome.bind_error (subst_raises hi a h)
  | .bin f a b, h => by
    simp only [must, List.mem_append] at h
    simp only [subst, evalP]
    rcases h with h | h
    · exact Outcome.bind_error (subst_raises hi a h)
    · cases (a.subst σ).evalP p row with
      | error k => rfl
      | ok x => rw [Outcome.ok_bind]; exact Outcome.bind_error (subst_raises hi b h)
  | .ifThen c t e, h => by
    simp only [must, List.mem_append, List.mem_filter, decide_eq_true_eq] at h
    simp only [subst, evalP]
    rcases h with h | ⟨ht, he⟩
    · exact Outcome.bind_error (subst_raises hi c h)
    · cases (c.subst σ).evalP p row with
      | error k => rfl
      | ok x =>
        simp only [bind, Except.bind]
        split
        · exact subst_raises hi t ht
        · exact subst_raises hi e he
  | .hof f l b, h => by
    simp only [subst, evalP]; exact Outcome.bind_error (subst_raises hi l h)

theorem Outcome.agree_of_err {o o' : Outcome} (h : o.err?.isSome) (h' : o'.err?.isSome) :
    o.Agree o' := by
  cases o <;> cases o' <;> simp_all [Outcome.err?, Outcome.Agree]

/-! ## The guards' functions in the reference

A template's guard is built from comparisons and NULL tests, which never
raise in the reference; `UnFn.raise` always does. The generator rewrites a
template with these before it splits cases. -/

theorem Lowering.ref_isNum (x : Value) : Profile.reference.un .isNum x = .ok (.bool x.isNum) := by
  cases x <;> rfl

theorem Lowering.ref_isNull (x : Value) :
    Profile.reference.un .isNull x = .ok (.bool (match x with | .null => true | _ => false)) := by
  cases x <;> rfl

theorem Lowering.ref_not (x : Value) :
    Profile.reference.un .not x = .ok (match x with | .bool b => .bool !b | _ => .null) := by
  cases x <;> rfl

theorem Lowering.ref_raise (m : String) (x : Value) :
    Profile.reference.un (.raise m) x = .error .raised := by
  cases x <;> rfl

theorem Lowering.ref_eq (x y : Value) : Profile.reference.bin .eq x y = .ok (BinFn.apply .eq x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_lt (x y : Value) : Profile.reference.bin .lt x y = .ok (BinFn.apply .lt x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_and (x y : Value) : Profile.reference.bin .and x y = .ok (and3 x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_or (x y : Value) : Profile.reference.bin .or x y = .ok (or3 x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.beq_int (a b : Int) : (a == b) = decide (a = b) := rfl

/-- A function the engine computes as the reference does agrees with it. -/
theorem Lowering.un_agree_of_eq {p : Profile} {f : UnFn}
    (h : ∀ x, p.un f x = Profile.reference.un f x) (x : Value) :
    (p.un f x).Agree (Profile.reference.un f x) := by
  rw [h]; exact Outcome.agree_refl _

theorem Lowering.bin_agree_of_eq {p : Profile} {f : BinFn}
    (h : ∀ x y, p.bin f x y = Profile.reference.bin f x y) (x y : Value) :
    (p.bin f x y).Agree (Profile.reference.bin f x y) := by
  rw [h]; exact Outcome.agree_refl _

/-- A template for the unary function `f` under `p`. -/
structure UnEntry (p : Profile) (f : UnFn) where
  tmpl : Expr
  strict : 0 ∈ tmpl.must
  agree : ∀ x, (tmpl.evalP p [x]).Agree (Profile.reference.un f x)

/-- A template for the binary function `f` under `p`. -/
structure BinEntry (p : Profile) (f : BinFn) where
  tmpl : Expr
  strict : 0 ∈ tmpl.must ∧ 1 ∈ tmpl.must
  agree : ∀ x y, (tmpl.evalP p [x, y]).Agree (Profile.reference.bin f x y)

/-- A lowering to an engine with profile `p`: a template for each function,
or none where it is refused. -/
structure Lowering (p : Profile) where
  un : (f : UnFn) → Option (UnEntry p f)
  bin : (f : BinFn) → Option (BinEntry p f)

/-- The lowering that writes every function as it is: correct for the
reference itself. -/
def UnEntry.native {p : Profile} (f : UnFn) (h : ∀ x, (p.un f x).Agree (Profile.reference.un f x)) :
    UnEntry p f :=
  ⟨.un f (.field 0), by simp [Expr.must], fun x => by simpa [Expr.evalP, bind, Except.bind] using h x⟩

def BinEntry.native {p : Profile} (f : BinFn)
    (h : ∀ x y, (p.bin f x y).Agree (Profile.reference.bin f x y)) : BinEntry p f :=
  ⟨.bin f (.field 0) (.field 1), by simp [Expr.must], fun x y => by simpa [Expr.evalP, bind, Except.bind] using h x y⟩

/-- An expression lowered with the table: each function replaced by its
template, applied to its lowered arguments; `none` if some function has no
entry. -/
def Lowering.lower {p : Profile} (L : Lowering p) : Expr → Option Expr
  | .lit v => some (.lit v)
  | .field i => some (.field i)
  | .un f a => do
    let e ← L.un f
    some (e.tmpl.subst [← L.lower a])
  | .bin f a b => do
    let e ← L.bin f
    let a' ← L.lower a
    let b' ← L.lower b
    some (e.tmpl.subst [a', b'])
  | .ifThen c t e => do some (.ifThen (← L.lower c) (← L.lower t) (← L.lower e))
  | .hof f l b => do some (.hof f (← L.lower l) (← L.lower b))

/-- **A lowered expression has the reference's outcome** under the engine's
profile: the same value, or an error. -/
theorem Lowering.lower_correct {p : Profile} (L : Lowering p) :
    ∀ (e t : Expr), L.lower e = some t → ∀ row : Row,
      Outcome.Agree (t.evalP p row) (e.evalP Profile.reference row)
  | .lit _, t, h, _ => by simp only [lower, Option.some.injEq] at h; subst h; exact Outcome.agree_refl _
  | .field _, t, h, _ => by simp only [lower, Option.some.injEq] at h; subst h; exact Outcome.agree_refl _
  | .un f a, t, h, row => by
    simp only [lower, bind, Option.bind_eq_some_iff, Option.some.injEq] at h
    obtain ⟨en, _, a', ha, rfl⟩ := h
    have iha := L.lower_correct a a' ha row
    cases hx : a'.evalP p row with
    | error k =>
      have hr : (a.evalP Profile.reference row).err?.isSome := by
        rw [← Outcome.agree_err iha, hx]; rfl
      refine Outcome.agree_of_err
        (Expr.subst_raises (p := p) (row := row) (σ := [a']) (i := 0) ?_ en.tmpl en.strict) ?_
      · simp [hx, Outcome.err?]
      · cases h' : a.evalP Profile.reference row with
        | ok _ => simp [h', Outcome.err?] at hr
        | error _ => simp [Expr.evalP, h', bind, Except.bind, Outcome.err?]
    | ok x =>
      rw [hx] at iha
      cases h' : a.evalP Profile.reference row with
      | error k => simp [h', Outcome.Agree] at iha
      | ok x' =>
        simp only [h', Outcome.Agree] at iha; subst iha
        simp only [Expr.evalP, h', bind, Except.bind]
        rw [Expr.evalP_subst (vs := [x]) (fun i => by cases i <;> simp [hx, Expr.evalP])]
        exact en.agree x
  | .bin f a b, t, h, row => by
    simp only [lower, bind, Option.bind_eq_some_iff, Option.some.injEq] at h
    obtain ⟨en, _, a', ha, b', hb, rfl⟩ := h
    have iha := L.lower_correct a a' ha row
    have ihb := L.lower_correct b b' hb row
    cases hx : a'.evalP p row with
    | error k =>
      have hr : (a.evalP Profile.reference row).err?.isSome := by
        rw [← Outcome.agree_err iha, hx]; rfl
      refine Outcome.agree_of_err
        (Expr.subst_raises (p := p) (row := row) (σ := [a', b']) (i := 0) ?_ en.tmpl en.strict.1) ?_
      · simp [hx, Outcome.err?]
      · cases h' : a.evalP Profile.reference row with
        | ok _ => simp [h', Outcome.err?] at hr
        | error _ => simp [Expr.evalP, h', bind, Except.bind, Outcome.err?]
    | ok x =>
      rw [hx] at iha
      cases h' : a.evalP Profile.reference row with
      | error k => simp [h', Outcome.Agree] at iha
      | ok x' =>
        simp only [h', Outcome.Agree] at iha; subst iha
        cases hy : b'.evalP p row with
        | error k =>
          have hr : (b.evalP Profile.reference row).err?.isSome := by
            rw [← Outcome.agree_err ihb, hy]; rfl
          refine Outcome.agree_of_err
            (Expr.subst_raises (p := p) (row := row) (σ := [a', b']) (i := 1) ?_ en.tmpl en.strict.2) ?_
          · simp [hy, Outcome.err?]
          · cases h'' : b.evalP Profile.reference row with
            | ok _ => simp [h'', Outcome.err?] at hr
            | error _ => simp [Expr.evalP, h', h'', bind, Except.bind, Outcome.err?]
        | ok y =>
          rw [hy] at ihb
          cases h'' : b.evalP Profile.reference row with
          | error k => simp [h'', Outcome.Agree] at ihb
          | ok y' =>
            simp only [h'', Outcome.Agree] at ihb; subst ihb
            simp only [Expr.evalP, h', h'', bind, Except.bind]
            rw [Expr.evalP_subst (vs := [x, y]) (fun i => by
              rcases i with _ | _ | i <;> simp [hx, hy, Expr.evalP])]
            exact en.agree x y
  | .ifThen c t' e, t, h, row => by
    simp only [lower, bind, Option.bind_eq_some_iff, Option.some.injEq] at h
    obtain ⟨c', hc, t'', ht, e', he, rfl⟩ := h
    simp only [Expr.evalP]
    refine Outcome.agree_bind (L.lower_correct c c' hc row) fun v => ?_
    split
    · exact L.lower_correct t' t'' ht row
    · exact L.lower_correct e e' he row
  | .hof f l b, t, h, row => by
    simp only [lower, bind, Option.bind_eq_some_iff, Option.some.injEq] at h
    obtain ⟨l', hl, b', hb, rfl⟩ := h
    simp only [Expr.evalP]
    exact Outcome.agree_bind (L.lower_correct l l' hl row) fun v =>
      HoFn.applyP_agree f v fun x => L.lower_correct b b' hb [x]

/-- **A lowered expression is exact** under the engine's profile. -/
theorem Lowering.lower_exact {p : Profile} (L : Lowering p) {e t : Expr} (hs : L.lower e = some t) :
    Expr.Exact p t e := by
  intro row v h
  have hag := L.lower_correct e t hs row
  rw [h] at hag
  cases hr : e.evalP Profile.reference row with
  | error k => rw [hr] at hag; simp [Outcome.Agree] at hag
  | ok w =>
    rw [hr] at hag; simp only [Outcome.Agree] at hag; subst hag
    exact (Expr.evalI_of_evalP h).trans (Expr.evalP_reference_ok hr)

/-- Every function has an entry. -/
def Lowering.Total {p : Profile} (L : Lowering p) : Prop :=
  (∀ f, (L.un f).isSome) ∧ ∀ f, (L.bin f).isSome

theorem Lowering.lower_isSome {p : Profile} {L : Lowering p} (hL : L.Total) :
    ∀ e : Expr, (L.lower e).isSome
  | .lit _ | .field _ => rfl
  | .un f a => by
    obtain ⟨en, he⟩ := Option.isSome_iff_exists.mp (hL.1 f)
    obtain ⟨a', ha⟩ := Option.isSome_iff_exists.mp (lower_isSome hL a)
    simp [lower, he, ha]
  | .bin f a b => by
    obtain ⟨en, he⟩ := Option.isSome_iff_exists.mp (hL.2 f)
    obtain ⟨a', ha⟩ := Option.isSome_iff_exists.mp (lower_isSome hL a)
    obtain ⟨b', hb⟩ := Option.isSome_iff_exists.mp (lower_isSome hL b)
    simp [lower, he, ha, hb]
  | .ifThen c t e => by
    obtain ⟨c', hc⟩ := Option.isSome_iff_exists.mp (lower_isSome hL c)
    obtain ⟨t', ht⟩ := Option.isSome_iff_exists.mp (lower_isSome hL t)
    obtain ⟨e', he⟩ := Option.isSome_iff_exists.mp (lower_isSome hL e)
    simp [lower, hc, ht, he]
  | .hof f l b => by
    obtain ⟨l', hl⟩ := Option.isSome_iff_exists.mp (lower_isSome hL l)
    obtain ⟨b', hb⟩ := Option.isSome_iff_exists.mp (lower_isSome hL b)
    simp [lower, hl, hb]

/-- The lowering of an expression, for a total table. -/
def Lowering.lowerE {p : Profile} (L : Lowering p) (e : Expr) : Expr := (L.lower e).getD e

theorem Lowering.lowerE_exact {p : Profile} {L : Lowering p} (hL : L.Total) (e : Expr) :
    Expr.Exact p (L.lowerE e) e := by
  obtain ⟨t, ht⟩ := Option.isSome_iff_exists.mp (lower_isSome hL e)
  simp only [lowerE, ht, Option.getD_some]
  exact L.lower_exact ht

/-- A plan lowered with the table: every expression lowered. -/
def Lowering.lowerRel {p : Profile} (L : Lowering p) (r : Rel) : Rel := r.mapExprs L.lowerE

/-- **A lowered plan runs correctly on the engine, or raises.** Unless one of
its expressions raises on a row the engine evaluates it on, the engine's
functions give `Rel.eval`'s rows, on every catalog. Trusted: that `p` is the
engine's profile, and that the SQL printer is faithful. -/
theorem Lowering.lowerRel_sound {p : Profile} {L : Lowering p} (hL : L.Total) {cat : Catalog}
    {r : Rel} (h : ¬(L.lowerRel r).Raises p cat) :
    (L.lowerRel r).evalI p.impl cat = r.eval cat :=
  Rel.evalI_mapExprs (lowerE_exact hL) (fun _ => rfl) h

end Substrait
