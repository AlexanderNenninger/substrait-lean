import SubstraitLean.Profile

/-!
# Lowerings: a table of proved templates (#241)

A **lowering** to an engine says, for each function of the model, how to
write it so that the engine, run under its profile `p`, gives the reference's
outcome. Each entry is a **template**: an expression over the function's
arguments, as fields `0`, `1`, …, built from functions the engine runs. A
template carries two proofs:

* `agree`: on every argument value, the template under `p` has the reference
  outcome of the function: the same value, or an error;
* `strict`: the template always reads each argument (`Expr.must`), so an
  argument that raises makes the template raise, as it makes the function
  raise in the reference.

The entries are generated by a metaprogram (`SubstraitLean/LoweringSearch.lean`)
and checked by the kernel like any declaration. This file proves, once for
every table, that lowering an expression with it is correct
(`Lowering.lower_correct`, `Lowering.lower_exact`), and lowering a plan
(`Lowering.lowerRel_sound`), by `Rel.evalI_mapExprs`.
-/

namespace Substrait

/-- The fields evaluating `t` always reads, unless an earlier part raises: a
`CASE` reads its condition's, and those both branches read. -/
def Expr.must : Expr → List Nat
  | .lit _ => []
  | .field i => [i]
  | .un _ a => a.must
  | .bin _ a b => a.must ++ b.must
  | .ifThen c t e => c.must ++ t.must.filter (· ∈ e.must)
  | .hof _ l _ => l.must

/-- Substituting expressions that evaluate to `vs` is evaluating on `vs`. -/
theorem Expr.evalP_subst {p : Profile} {row : Row} {σ : List Expr} {vs : List Value}
    (hσ : ∀ i, (σ.getD i (.lit .null)).evalP p row = .ok (vs.getD i .null)) :
    ∀ t : Expr, (t.subst σ).evalP p row = t.evalP p vs
  | .lit _ => rfl
  | .field i => hσ i
  | .un f a => by simp only [subst, evalP, evalP_subst hσ a]
  | .bin f a b => by simp only [subst, evalP, evalP_subst hσ a, evalP_subst hσ b]
  | .ifThen c t e => by simp only [subst, evalP, evalP_subst hσ c, evalP_subst hσ t, evalP_subst hσ e]
  | .hof f l b => by
    simp only [subst, evalP, evalP_subst hσ l]
    congr 1; funext v; congr 1; funext x
    refine evalP_subst (row := x :: row) (vs := x :: vs) (fun i => ?_) b
    cases i with
    | zero => rfl
    | succ i => simp only [List.getD_cons_succ, getD_map_shift, Expr.evalP_shift_cons, hσ]

theorem Outcome.bind_error {o : Outcome} {g : Value → Outcome} (h : o.err?.isSome) :
    Outcome.err? (o >>= g) |>.isSome := by
  cases o <;> simp_all [Outcome.err?] <;> rfl

theorem Outcome.ok_bind {x : Value} {g : Value → Outcome} : (Except.ok x >>= g : Outcome) = g x := rfl

/-- A template raises when an argument it always reads raises. -/
theorem Expr.subst_raises {p : Profile} {row : Row} {σ : List Expr} {i : Nat}
    (hi : ((σ.getD i (.lit .null)).evalP p row).err?.isSome) :
    ∀ t : Expr, i ∈ t.must → ((t.subst σ).evalP p row).err?.isSome
  | .lit _, h => by simp [must] at h
  | .field j, h => by simp only [must, List.mem_singleton] at h; subst h; exact hi
  | .un f a, h => by
    simp only [subst, evalP]; exact Outcome.bind_error (subst_raises hi a h)
  | .bin f a b, h => by
    simp only [must, List.mem_append] at h
    simp only [subst, evalP]
    rcases h with h | h
    · exact Outcome.bind_error (subst_raises hi a h)
    · cases (a.subst σ).evalP p row with
      | error k => rfl
      | ok x => rw [Outcome.ok_bind]; exact Outcome.bind_error (subst_raises hi b h)
  | .ifThen c t e, h => by
    simp only [must, List.mem_append, List.mem_filter, decide_eq_true_eq] at h
    simp only [subst, evalP]
    rcases h with h | ⟨ht, he⟩
    · exact Outcome.bind_error (subst_raises hi c h)
    · cases (c.subst σ).evalP p row with
      | error k => rfl
      | ok x =>
        simp only [bind, Except.bind]
        split
        · exact subst_raises hi t ht
        · exact subst_raises hi e he
  | .hof f l b, h => by
    simp only [subst, evalP]; exact Outcome.bind_error (subst_raises hi l h)

theorem Outcome.agree_of_err {o o' : Outcome} (h : o.err?.isSome) (h' : o'.err?.isSome) :
    o.Agree o' := by
  cases o <;> cases o' <;> simp_all [Outcome.err?, Outcome.Agree]

/-! ## The guards' functions in the reference

A template's guard is built from comparisons and NULL tests, which never
raise in the reference; `UnFn.raise` always does. The generator rewrites a
template with these before it splits cases. -/

theorem Lowering.ref_isNum (k : NumKind) (x : Value) :
    Profile.reference.un (.isNum k) x = .ok (.bool (x.isNum k)) := by
  cases x <;> rfl

theorem Lowering.ref_isNull (x : Value) :
    Profile.reference.un .isNull x = .ok (.bool (match x with | .null => true | _ => false)) := by
  cases x <;> rfl

theorem Lowering.ref_not (x : Value) :
    Profile.reference.un .not x = .ok (match x with | .bool b => .bool !b | _ => .null) := by
  cases x <;> rfl

theorem Lowering.ref_raise (m : String) (x : Value) :
    Profile.reference.un (.raise m) x = .error .raised := by
  cases x <;> rfl

theorem Lowering.ref_eq (x y : Value) : Profile.reference.bin .eq x y = .ok (BinFn.apply .eq x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_lt (x y : Value) : Profile.reference.bin .lt x y = .ok (BinFn.apply .lt x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_greatest (x y : Value) :
    Profile.reference.bin .greatest x y = .ok (BinFn.apply .greatest x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_least (x y : Value) :
    Profile.reference.bin .least x y = .ok (BinFn.apply .least x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_and (x y : Value) : Profile.reference.bin .and x y = .ok (and3 x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_or (x y : Value) : Profile.reference.bin .or x y = .ok (or3 x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.beq_int (a b : Int) : (a == b) = decide (a = b) := rfl

/-- 128-bit arithmetic (decimals' `+`, `-`, `×` on unscaled integers, and `%`
by a constant other than zero): the functions templates compute with. -/
theorem Lowering.ref_dadd (x y : Value) : Profile.reference.bin .dadd x y = .ok (BinFn.apply .dadd x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_dsub (x y : Value) : Profile.reference.bin .dsub x y = .ok (BinFn.apply .dsub x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_dmul (x y : Value) : Profile.reference.bin .dmul x y = .ok (BinFn.apply .dmul x y) := by
  cases x <;> cases y <;> rfl

theorem Lowering.ref_imod_int (a b : Int) (hb : b ≠ 0) :
    Profile.reference.bin .imod (.int a) (.int b) = .ok (.int (a.tmod b)) := by
  simp [Profile.reference, raiseIf, BinFn.issue, BinFn.apply, hb]

/-- Wrapping around in truncating arithmetic (`%` of SQL, `Int.tmod`): adding
the modulus to a remainder makes it non-negative, so a second remainder is the
floored one. The wrap schema (`overflow` = `SILENT`) rests on it (#241). -/
theorem Lowering.tmod_add_tmod (a m : Int) (hm : 0 < m) : (a.tmod m + m).tmod m = a % m := by
  have h1 := Int.tmod_add_tdiv_mul a m
  have h2 := Int.lt_tmod_of_pos a hm
  have h3 : a.tmod m + m = a.tmod m + 1 * m := by omega
  rw [Int.tmod_eq_emod_of_nonneg (by omega), h3, Int.add_mul_emod_self_right]
  conv => rhs; rw [← h1]
  rw [Int.add_mul_emod_self_right]

/-- A function the engine computes as the reference does agrees with it. -/
theorem Lowering.un_agree_of_eq {p : Profile} {f : UnFn}
    (h : ∀ x, p.un f x = Profile.reference.un f x) (x : Value) :
    (p.un f x).Agree (Profile.reference.un f x) := by
  rw [h]; exact Outcome.agree_refl _

theorem Lowering.bin_agree_of_eq {p : Profile} {f : BinFn}
    (h : ∀ x y, p.bin f x y = Profile.reference.bin f x y) (x y : Value) :
    (p.bin f x y).Agree (Profile.reference.bin f x y) := by
  rw [h]; exact Outcome.agree_refl _

/-! ## The guards' functions in DuckDB: the reference's -/

theorem Lowering.duck_bin_ref {s : DuckDBSettings} {f : BinFn} (h : ∀ x y, duckBin s f x y = none)
    (v w : Value) : (Profile.duckdb s).bin f v w = Profile.reference.bin f v w := by
  unfold Profile.duckdb; dsimp only; split <;> (try split) <;> simp [h]

theorem Lowering.duck_un_ref {s : DuckDBSettings} {f : UnFn} (h : ∀ x, duckUn s f x = none)
    (v : Value) : (Profile.duckdb s).un f v = Profile.reference.un f v := by
  unfold Profile.duckdb; dsimp only; split <;> simp [h]

theorem Lowering.duck_lt (s : DuckDBSettings) (x y : Value) :
    (Profile.duckdb s).bin .lt x y = .ok (BinFn.apply .lt x y) :=
  (Lowering.duck_bin_ref (fun _ _ => rfl) x y).trans (Lowering.ref_lt x y)
theorem Lowering.duck_eq (s : DuckDBSettings) (x y : Value) :
    (Profile.duckdb s).bin .eq x y = .ok (BinFn.apply .eq x y) :=
  (Lowering.duck_bin_ref (fun _ _ => rfl) x y).trans (Lowering.ref_eq x y)
theorem Lowering.duck_and (s : DuckDBSettings) (x y : Value) :
    (Profile.duckdb s).bin .and x y = .ok (and3 x y) :=
  (Lowering.duck_bin_ref (fun _ _ => rfl) x y).trans (Lowering.ref_and x y)
theorem Lowering.duck_or (s : DuckDBSettings) (x y : Value) :
    (Profile.duckdb s).bin .or x y = .ok (or3 x y) :=
  (Lowering.duck_bin_ref (fun _ _ => rfl) x y).trans (Lowering.ref_or x y)
theorem Lowering.duck_dadd (s : DuckDBSettings) (x y : Value) :
    (Profile.duckdb s).bin .dadd x y = .ok (BinFn.apply .dadd x y) :=
  (Lowering.duck_bin_ref (fun _ _ => rfl) x y).trans (Lowering.ref_dadd x y)
theorem Lowering.duck_dsub (s : DuckDBSettings) (x y : Value) :
    (Profile.duckdb s).bin .dsub x y = .ok (BinFn.apply .dsub x y) :=
  (Lowering.duck_bin_ref (fun _ _ => rfl) x y).trans (Lowering.ref_dsub x y)
theorem Lowering.duck_dmul (s : DuckDBSettings) (x y : Value) :
    (Profile.duckdb s).bin .dmul x y = .ok (BinFn.apply .dmul x y) :=
  (Lowering.duck_bin_ref (fun _ _ => rfl) x y).trans (Lowering.ref_dmul x y)
theorem Lowering.duck_not (s : DuckDBSettings) (x : Value) :
    (Profile.duckdb s).un .not x = .ok (match x with | .bool b => .bool !b | _ => .null) :=
  (Lowering.duck_un_ref (fun _ => rfl) x).trans (Lowering.ref_not x)
theorem Lowering.duck_isNum (s : DuckDBSettings) (k : NumKind) (x : Value) :
    (Profile.duckdb s).un (.isNum k) x = .ok (.bool (x.isNum k)) :=
  (Lowering.duck_un_ref (fun _ => rfl) x).trans (Lowering.ref_isNum k x)
theorem Lowering.duck_raise (s : DuckDBSettings) (m : String) (x : Value) :
    (Profile.duckdb s).un (.raise m) x = .error .raised :=
  (Lowering.duck_un_ref (fun _ => rfl) x).trans (Lowering.ref_raise m x)

/-- `%` by `2⁶⁴`, which the wrap-around computes with. -/
theorem Lowering.duck_imod_pow64 (s : DuckDBSettings) (x : Value) :
    (Profile.duckdb s).bin .imod x (.int (2 ^ 64)) = .ok (BinFn.apply .imod x (.int (2 ^ 64))) := by
  have h0 : ¬((2 : Int) ^ 64 = 0) := by decide
  have h1 : ¬((2 : Int) ^ 64 = -1) := by decide
  cases x
  case int a =>
    simp only [Profile.duckdb, BinFn.onFloats, duckBin, h0, h1, false_and, ite_false, Bool.false_eq_true,
      Option.getD_none, Profile.reference, raiseIf, BinFn.issue]
  case tod a =>
    simp only [Profile.duckdb, Profile.reference, raiseIf, BinFn.issue, h0, ite_false]
  all_goals rfl

/-! `floor`, which the guard of `power` compares with its argument. -/

theorem Lowering.apply_ffloor_float (c : Int) :
    UnFn.apply .ffloor (.float c) = .float (FloatCode.floor c) := rfl
theorem Lowering.apply_ffloor_null : UnFn.apply .ffloor .null = .null := rfl
theorem Lowering.apply_ffloor_bool (b : Bool) : UnFn.apply .ffloor (.bool b) = .null := rfl
theorem Lowering.apply_ffloor_int (c : Int) : UnFn.apply .ffloor (.int c) = .null := rfl
theorem Lowering.apply_ffloor_date (c : Int) : UnFn.apply .ffloor (.date c) = .null := rfl
theorem Lowering.apply_ffloor_ts (c : Int) : UnFn.apply .ffloor (.ts c) = .null := rfl
theorem Lowering.apply_ffloor_tod (c : Int) : UnFn.apply .ffloor (.tod c) = .null := rfl
theorem Lowering.apply_ffloor_dec (s : Nat) (c : Int) : UnFn.apply .ffloor (.dec s c) = .null := rfl
theorem Lowering.apply_ffloor_str (t : String) : UnFn.apply .ffloor (.str t) = .null := rfl
theorem Lowering.apply_ffloor_list (vs : List Value) : UnFn.apply .ffloor (.list vs) = .null := rfl
theorem Lowering.apply_ffloor_struct (vs : List Value) : UnFn.apply .ffloor (.struct vs) = .null := rfl

/-! `<<` and `>>` as the templates compute them (`LoweringSearch.schemaBin?`). -/

theorem Lowering.shl_toInt (a : Int) (n : Nat) (h : n < 64) :
    (BitVec.ofInt 64 a <<< n).toInt = Int.bmod (a * 2 ^ n) (2 ^ 64) := by
  rw [BitVec.shiftLeft_eq_mul_twoPow, BitVec.toInt_mul]
  simp only [BitVec.toInt_ofInt, BitVec.toInt_twoPow, Int.bmod_mul_bmod]
  have h64 : ¬ 64 ≤ n := by omega
  simp only [h64, ite_false, Int.natCast_pow]
  split
  · have hn : n = 63 := by omega
    subst hn
    have e : a * -(2:Int) ^ 63 = a * 2 ^ 63 + ((2 ^ 64 : Nat) : Int) * (-a) := by
      have : ((2 ^ 64 : Nat) : Int) = 2 ^ 63 * 2 := by decide
      rw [this, Int.mul_neg, Int.mul_assoc, Int.mul_comm 2 (-a), Int.neg_mul, Int.mul_neg,
        ← Int.mul_assoc, Int.mul_comm (2 ^ 63) a]
      omega
    rw [show ((2:Nat):Int) = 2 from rfl, e, Int.add_mul_bmod_self_left]
  · rfl

theorem Lowering.bmod_fit (x : Int) : Int.bmod x (2 ^ 64) = (x + 2 ^ 63) % 2 ^ 64 - 2 ^ 63 := by
  rw [Int.bmod_def]
  simp only [Int.natCast_pow, Int.cast_ofNat_Int]
  split <;> omega

/-- A left shift wraps `a · 2ᵇ` around at 64 bits. -/
-- The conditions as the templates' guards compare (`b < 0`, `b < 64`), so
-- that the proofs' case splits decide them.
theorem Lowering.shl_apply (a b : Int) : BitOp.apply .shl a b =
    if b < 0 then none
    else if b < 64 then some ((a * 2 ^ b.toNat + 2 ^ 63) % 2 ^ 64 - 2 ^ 63) else none := by
  simp only [BitOp.apply]
  by_cases h0 : b < 0
  · have hn : ¬0 ≤ b := by omega
    simp only [hn, false_and, h0, ite_false, ite_true]
  · by_cases h1 : b < 64
    · have hb : 0 ≤ b := by omega
      simp only [hb, h1, and_self, h0, ite_true, ite_false]
      rw [Lowering.shl_toInt a b.toNat (by omega), Lowering.bmod_fit]
    · simp only [h1, and_false, h0, ite_false]

theorem Lowering.shr_apply (a b : Int) : BitOp.apply .shr a b =
    if b < 0 then none
    else if b < 64 then some ((BitVec.ofInt 64 a).sshiftRight b.toNat).toInt else none := by
  simp only [BitOp.apply]
  by_cases h0 : b < 0
  · have hn : ¬0 ≤ b := by omega
    simp only [hn, false_and, h0, ite_false, ite_true]
  · by_cases h1 : b < 64
    · have hb : 0 ≤ b := by omega
      simp only [hb, h1, and_self, h0, ite_true, ite_false]
    · simp only [h1, and_false, h0, ite_false]

/-- `CASE WHEN #1 = k THEN 2ᵏ …` over `ks`, else NULL: `2ʸ` for a shift `y`, which
`<<`'s template multiplies by (`LoweringSearch.schemaBin?`). One lemma, by induction,
rather than a case per shift in every proof. -/
@[irreducible] def Lowering.pow2Chain (ks : List Nat) : Expr :=
  ks.foldr (fun (k : Nat) (e : Expr) =>
    .ifThen (.bin .eq (.field 1) (.lit (.int (k : Int)))) (.lit (.int ((2 : Int) ^ k))) e) (.lit .null)

theorem Lowering.pow2Chain_eval (s : DuckDBSettings) (x y : Value) (ks : List Nat) :
    (Lowering.pow2Chain ks).evalP (Profile.duckdb s) [x, y] =
      .ok (match y with
        | .int b => if 0 ≤ b ∧ b.toNat ∈ ks then .int (2 ^ b.toNat) else .null
        | _ => .null) := by
  induction ks with
  | nil => cases y <;> simp [Lowering.pow2Chain, Expr.evalP]
  | cons k ks ih =>
    simp only [Lowering.pow2Chain, List.foldr_cons] at ih ⊢
    simp only [Expr.evalP, List.getD_cons_zero, List.getD_cons_succ, Outcome.ok_bind]
    rw [ih]
    cases y with
    | int b =>
      simp only [Profile.duckdb, duckBin, BinFn.onFloats, Option.getD, Profile.reference, raiseIf, BinFn.issue,
        BinFn.apply]
      by_cases h : b = (k : Int)
      · subst h
        simp [Value.isTrue, bind, Except.bind]
      · by_cases h0 : 0 ≤ b
        · have hk : b.toNat ≠ k := by omega
          simp [h, h0, hk, Value.isTrue, bind, Except.bind]
        · simp [h, h0, Value.isTrue, bind, Except.bind]
    | _ => simp only [Profile.duckdb, Profile.reference, raiseIf, BinFn.issue, BinFn.apply, Value.numPair,
        Value.isTrue, Outcome.ok_bind, Bool.false_eq_true, ite_false]

/-- `<<` for DuckDB: a shift outside `0`–`63` raises; otherwise `x · 2ʸ`
(`Lowering.pow2Chain`) wrapped around at 64 bits in 128-bit arithmetic, as
`overflow` = `SILENT` does. -/
def Lowering.shlTemplate : Expr :=
  let h : Int := 2 ^ 63
  let m : Int := 2 ^ 64
  let wrap (x : Expr) : Expr :=
    .bin .dsub (.bin .imod (.bin .dadd (.bin .imod (.bin .dadd x (.lit (.int h))) (.lit (.int m)))
      (.lit (.int m))) (.lit (.int m))) (.lit (.int h))
  .ifThen (.bin .and (.un (.isNum .int) (.field 0))
      (.bin .or (.bin .lt (.field 1) (.lit (.int 0))) (.un .not (.bin .lt (.field 1) (.lit (.int 64))))))
    (.un (.raise "domain error") (.field 1))
    -- `dmul` reads decimals too: an integer only (#923).
    (.ifThen (.un (.isNum .int) (.field 0))
      (wrap (.bin .dmul (.field 0) (Lowering.pow2Chain (List.range 64)))) (.lit .null))

theorem Lowering.bit_shl_agree (s : DuckDBSettings) (x y : Value) :
    (Lowering.shlTemplate.evalP (Profile.duckdb s) [x, y]).Agree
      (Profile.reference.bin (.bit .shl) x y) := by
  simp only [Lowering.shlTemplate, Expr.evalP, List.getD_cons_zero, List.getD_cons_succ,
    Lowering.pow2Chain_eval, Outcome.ok_bind, Lowering.duck_lt, Lowering.duck_and, Lowering.duck_or,
    Lowering.duck_not, Lowering.duck_isNum, Lowering.duck_raise, Lowering.duck_dmul,
    Lowering.duck_dadd, Lowering.duck_dsub, Lowering.duck_imod_pow64]
  cases x
  case int a =>
    cases y
    case int b =>
      by_cases h0 : b < 0
      · simp [h0, Profile.reference, raiseIf, BinFn.issue, BinFn.apply, Value.isNum, Value.numOf?, Lowering.shl_apply,
          domainIssue, Value.isTrue, and3, or3, Outcome.Agree, Issue.isError]
      · by_cases h1 : b < 64
        · have hb : 0 ≤ b := by omega
          simp [h0, h1, hb, Profile.reference, raiseIf, BinFn.issue, BinFn.apply, Value.isNum, Value.numOf?, Lowering.shl_apply,
          domainIssue, Value.isTrue, and3, or3, Outcome.Agree, Issue.isError, Lowering.tmod_add_tmod]
        · simp [h0, h1, Profile.reference, raiseIf, BinFn.issue, BinFn.apply, Value.isNum, Value.numOf?, Lowering.shl_apply,
          domainIssue, Value.isTrue, and3, or3, Outcome.Agree, Issue.isError]
    all_goals rfl
  all_goals (cases y <;> rfl)

/-- A template for the unary function `f` under `p`. -/
structure UnEntry (p : Profile) (f : UnFn) where
  tmpl : Expr
  strict : 0 ∈ tmpl.must
  agree : ∀ x, (tmpl.evalP p [x]).Agree (Profile.reference.un f x)

/-- A template for the binary function `f` under `p`. -/
structure BinEntry (p : Profile) (f : BinFn) where
  tmpl : Expr
  strict : 0 ∈ tmpl.must ∧ 1 ∈ tmpl.must
  agree : ∀ x y, (tmpl.evalP p [x, y]).Agree (Profile.reference.bin f x y)

/-- A lowering to an engine with profile `p`: a template for each function,
or none where it is refused. -/
structure Lowering (p : Profile) where
  un : (f : UnFn) → Option (UnEntry p f)
  bin : (f : BinFn) → Option (BinEntry p f)

/-- The lowering that writes every function as it is: correct for the
reference itself. -/
def UnEntry.native {p : Profile} (f : UnFn) (h : ∀ x, (p.un f x).Agree (Profile.reference.un f x)) :
    UnEntry p f :=
  ⟨.un f (.field 0), by simp [Expr.must], fun x => by simpa [Expr.evalP, bind, Except.bind] using h x⟩

def BinEntry.native {p : Profile} (f : BinFn)
    (h : ∀ x y, (p.bin f x y).Agree (Profile.reference.bin f x y)) : BinEntry p f :=
  ⟨.bin f (.field 0) (.field 1), by simp [Expr.must], fun x y => by simpa [Expr.evalP, bind, Except.bind] using h x y⟩

/-- An expression lowered with the table: each function replaced by its
template, applied to its lowered arguments; `none` if some function has no
entry. -/
def Lowering.lower {p : Profile} (L : Lowering p) : Expr → Option Expr
  | .lit v => some (.lit v)
  | .field i => some (.field i)
  | .un f a => do
    let e ← L.un f
    some (e.tmpl.subst [← L.lower a])
  | .bin f a b => do
    let e ← L.bin f
    let a' ← L.lower a
    let b' ← L.lower b
    some (e.tmpl.subst [a', b'])
  | .ifThen c t e => do some (.ifThen (← L.lower c) (← L.lower t) (← L.lower e))
  | .hof f l b => do some (.hof f (← L.lower l) (← L.lower b))

/-- **A lowered expression has the reference's outcome** under the engine's
profile: the same value, or an error. -/
theorem Lowering.lower_correct {p : Profile} (L : Lowering p) :
    ∀ (e t : Expr), L.lower e = some t → ∀ row : Row,
      Outcome.Agree (t.evalP p row) (e.evalP Profile.reference row)
  | .lit _, t, h, _ => by simp only [lower, Option.some.injEq] at h; subst h; exact Outcome.agree_refl _
  | .field _, t, h, _ => by simp only [lower, Option.some.injEq] at h; subst h; exact Outcome.agree_refl _
  | .un f a, t, h, row => by
    simp only [lower, bind, Option.bind_eq_some_iff, Option.some.injEq] at h
    obtain ⟨en, _, a', ha, rfl⟩ := h
    have iha := L.lower_correct a a' ha row
    cases hx : a'.evalP p row with
    | error k =>
      have hr : (a.evalP Profile.reference row).err?.isSome := by
        rw [← Outcome.agree_err iha, hx]; rfl
      refine Outcome.agree_of_err
        (Expr.subst_raises (p := p) (row := row) (σ := [a']) (i := 0) ?_ en.tmpl en.strict) ?_
      · simp [hx, Outcome.err?]
      · cases h' : a.evalP Profile.reference row with
        | ok _ => simp [h', Outcome.err?] at hr
        | error _ => simp [Expr.evalP, h', bind, Except.bind, Outcome.err?]
    | ok x =>
      rw [hx] at iha
      cases h' : a.evalP Profile.reference row with
      | error k => simp [h', Outcome.Agree] at iha
      | ok x' =>
        simp only [h', Outcome.Agree] at iha; subst iha
        simp only [Expr.evalP, h', bind, Except.bind]
        rw [Expr.evalP_subst (vs := [x]) (fun i => by cases i <;> simp [hx, Expr.evalP])]
        exact en.agree x
  | .bin f a b, t, h, row => by
    simp only [lower, bind, Option.bind_eq_some_iff, Option.some.injEq] at h
    obtain ⟨en, _, a', ha, b', hb, rfl⟩ := h
    have iha := L.lower_correct a a' ha row
    have ihb := L.lower_correct b b' hb row
    cases hx : a'.evalP p row with
    | error k =>
      have hr : (a.evalP Profile.reference row).err?.isSome := by
        rw [← Outcome.agree_err iha, hx]; rfl
      refine Outcome.agree_of_err
        (Expr.subst_raises (p := p) (row := row) (σ := [a', b']) (i := 0) ?_ en.tmpl en.strict.1) ?_
      · simp [hx, Outcome.err?]
      · cases h' : a.evalP Profile.reference row with
        | ok _ => simp [h', Outcome.err?] at hr
        | error _ => simp [Expr.evalP, h', bind, Except.bind, Outcome.err?]
    | ok x =>
      rw [hx] at iha
      cases h' : a.evalP Profile.reference row with
      | error k => simp [h', Outcome.Agree] at iha
      | ok x' =>
        simp only [h', Outcome.Agree] at iha; subst iha
        cases hy : b'.evalP p row with
        | error k =>
          have hr : (b.evalP Profile.reference row).err?.isSome := by
            rw [← Outcome.agree_err ihb, hy]; rfl
          refine Outcome.agree_of_err
            (Expr.subst_raises (p := p) (row := row) (σ := [a', b']) (i := 1) ?_ en.tmpl en.strict.2) ?_
          · simp [hy, Outcome.err?]
          · cases h'' : b.evalP Profile.reference row with
            | ok _ => simp [h'', Outcome.err?] at hr
            | error _ => simp [Expr.evalP, h', h'', bind, Except.bind, Outcome.err?]
        | ok y =>
          rw [hy] at ihb
          cases h'' : b.evalP Profile.reference row with
          | error k => simp [h'', Outcome.Agree] at ihb
          | ok y' =>
            simp only [h'', Outcome.Agree] at ihb; subst ihb
            simp only [Expr.evalP, h', h'', bind, Except.bind]
            rw [Expr.evalP_subst (vs := [x, y]) (fun i => by
              rcases i with _ | _ | i <;> simp [hx, hy, Expr.evalP])]
            exact en.agree x y
  | .ifThen c t' e, t, h, row => by
    simp only [lower, bind, Option.bind_eq_some_iff, Option.some.injEq] at h
    obtain ⟨c', hc, t'', ht, e', he, rfl⟩ := h
    simp only [Expr.evalP]
    refine Outcome.agree_bind (L.lower_correct c c' hc row) fun v => ?_
    split
    · exact L.lower_correct t' t'' ht row
    · exact L.lower_correct e e' he row
  | .hof f l b, t, h, row => by
    simp only [lower, bind, Option.bind_eq_some_iff, Option.some.injEq] at h
    obtain ⟨l', hl, b', hb, rfl⟩ := h
    simp only [Expr.evalP]
    exact Outcome.agree_bind (L.lower_correct l l' hl row) fun v =>
      HoFn.applyP_agree f v fun x => L.lower_correct b b' hb (x :: row)

/-- **A lowered expression is exact** under the engine's profile. -/
theorem Lowering.lower_exact {p : Profile} (L : Lowering p) {e t : Expr} (hs : L.lower e = some t) :
    Expr.Exact p t e := by
  intro row v h
  have hag := L.lower_correct e t hs row
  rw [h] at hag
  cases hr : e.evalP Profile.reference row with
  | error k => rw [hr] at hag; simp [Outcome.Agree] at hag
  | ok w =>
    rw [hr] at hag; simp only [Outcome.Agree] at hag; subst hag
    exact (Expr.evalI_of_evalP h).trans (Expr.evalP_reference_ok hr)

/-- Every function has an entry. -/
def Lowering.Total {p : Profile} (L : Lowering p) : Prop :=
  (∀ f, (L.un f).isSome) ∧ ∀ f, (L.bin f).isSome

theorem Lowering.lower_isSome {p : Profile} {L : Lowering p} (hL : L.Total) :
    ∀ e : Expr, (L.lower e).isSome
  | .lit _ | .field _ => rfl
  | .un f a => by
    obtain ⟨en, he⟩ := Option.isSome_iff_exists.mp (hL.1 f)
    obtain ⟨a', ha⟩ := Option.isSome_iff_exists.mp (lower_isSome hL a)
    simp [lower, he, ha]
  | .bin f a b => by
    obtain ⟨en, he⟩ := Option.isSome_iff_exists.mp (hL.2 f)
    obtain ⟨a', ha⟩ := Option.isSome_iff_exists.mp (lower_isSome hL a)
    obtain ⟨b', hb⟩ := Option.isSome_iff_exists.mp (lower_isSome hL b)
    simp [lower, he, ha, hb]
  | .ifThen c t e => by
    obtain ⟨c', hc⟩ := Option.isSome_iff_exists.mp (lower_isSome hL c)
    obtain ⟨t', ht⟩ := Option.isSome_iff_exists.mp (lower_isSome hL t)
    obtain ⟨e', he⟩ := Option.isSome_iff_exists.mp (lower_isSome hL e)
    simp [lower, hc, ht, he]
  | .hof f l b => by
    obtain ⟨l', hl⟩ := Option.isSome_iff_exists.mp (lower_isSome hL l)
    obtain ⟨b', hb⟩ := Option.isSome_iff_exists.mp (lower_isSome hL b)
    simp [lower, hl, hb]

/-- The lowering of an expression, for a total table. -/
def Lowering.lowerE {p : Profile} (L : Lowering p) (e : Expr) : Expr := (L.lower e).getD e

theorem Lowering.lowerE_exact {p : Profile} {L : Lowering p} (hL : L.Total) (e : Expr) :
    Expr.Exact p (L.lowerE e) e := by
  obtain ⟨t, ht⟩ := Option.isSome_iff_exists.mp (lower_isSome hL e)
  simp only [lowerE, ht, Option.getD_some]
  exact L.lower_exact ht

/-- A plan lowered with the table: every expression lowered. -/
def Lowering.lowerRel {p : Profile} (L : Lowering p) (r : Rel) : Rel := r.mapExprs L.lowerE

/-- **A lowered plan runs correctly on the engine, or raises.** Unless one of
its expressions raises on a row the engine evaluates it on, the engine's
functions give `Rel.eval`'s rows, on every catalog. Trusted: that `p` is the
engine's profile, and that the SQL printer is faithful. -/
theorem Lowering.lowerRel_sound {p : Profile} {L : Lowering p} (hL : L.Total) {cat : Catalog}
    {r : Rel} (h : ¬(L.lowerRel r).Raises p cat) :
    (L.lowerRel r).eval cat p.impl = r.eval cat :=
  Rel.evalI_mapExprs (lowerE_exact hL) (fun _ => rfl) h

end Substrait
