import SubstraitLean.LoweringHint
import SubstraitLean.LoweringDuckDB.On.Table

/-!
# The generated lowering to DuckDB (#241)

The table for DuckDB's profile under its default settings
(`error_on_division_by_zero` and `ieee_floating_point_ops` on), `duckdbOn`, is
generated: the search (`generate_lowering`, `SubstraitLean/LoweringSearch.lean`)
runs in `scripts/RegenLowering.lean` (`poe regen-lowering`) and writes each
entry it found, with its proof, to `SubstraitLean/LoweringDuckDB/On`, one
module per area, which a build checks in parallel without searching
(`SubstraitLean/Generated.lean`). Other settings have no table: sverify runs
DuckDB with its defaults, and the SQL it writes for DuckDB assumes them (#241). Where
DuckDB differs from the reference (FACTS R15), an entry is a guard that
raises where the reference does, or `MIN % -1` and `<<` as the reference
computes them; elsewhere the native function.

Its correctness (`Lowering.duckdb_exact`, `Rel.duckdb_shim_sound`) follows
from the generic theorems of `SubstraitLean/Lowering.lean`. `duckdbOn.coverage`
lists how each construct is lowered; the golden test
`tests/lowering/duckdb.expected` records them (`substrait-check
--lowering-coverage`), so a change to the generator's output shows in review.
-/

namespace Substrait

/-- A new `SubstraitLean/LoweringCache.lean` from this build's coverage
(`substrait-check --lowering-cache`): each construct's template as the report
prints it, or, where none was found, why (the breadcrumb). -/
def loweringCacheSource : String :=
  let entry (table : String) (row : String × String × Nat) : String :=
    let (construct, how, _) := row
    let found := !how.startsWith "missing"
    let template := if found then how else ""
    let note := if found then "" else how
    s!"  \{ table := {repr table}, construct := {repr construct},\n    template := {repr template}, note := {repr note} }"
  let rows := duckdbOn.coverage.map (entry "duckdbOn")
  "import SubstraitLean.LoweringHint\n\n/-!\n# The lowering generator's cache (#241, #242)\n\n" ++
  "Generated by `substrait-check --lowering-cache` from a build's coverage. See\n" ++
  "`SubstraitLean/LoweringHint.lean`.\n-/\n\nnamespace Substrait\n\n" ++
  "def loweringCache : List LoweringHint := [\n" ++ ",\n".intercalate rows ++ "\n]\n\nend Substrait\n"

/-! ## The table, exported

`substrait-check --lowering-table` prints the entries that are not native as
JSON, for the SQL printer's table interpreter (`sverify.sql.lowering`, #241),
which writes each construct as its template says instead of by hand. -/

namespace LoweringExport

open Lean (Json)

/-- A function's name in the export: the model's, with its parameters. -/
def unName : UnFn → String
  | .isNum => "isNum" | .isNull => "isNull" | .not => "not" | .ffloor => "ffloor"
  | .raise _ => "raise" | .fmath f => s!"fmath:{f.name}"
  | .fit m w => s!"fit:{m.name}:{w.bits}"
  | f => reprStr f

def binName : BinFn → String
  | .eq => "eq" | .lt => "lt" | .and => "and" | .or => "or"
  | .dadd => "dadd" | .dsub => "dsub" | .dmul => "dmul" | .imod => "imod" | .idiv => "idiv"
  | .fadd => "fadd" | .fsub => "fsub" | .fmul => "fmul" | .fdiv => "fdiv" | .fmod => "fmod"
  | .fpow => "fpow" | .fatan2 => "fatan2" | .bit op => s!"bit:{op.name}"
  | f => reprStr f

/-- A literal; `float` says an integer is a double's code (`SubstraitLean/Float.lean`). -/
def litJson (float : Bool) : Value → Json
  | .null => Json.mkObj [("null", true)]
  | .bool b => Json.mkObj [("bool", b)]
  | .int i => Json.mkObj [(if float then "code" else "int", toString i)]
  | v => Json.mkObj [("unsupported", reprStr v)]

/-- A template as JSON: fields, literals, calls and `CASE`s. -/
def exprJson (float : Bool) : Expr → Json
  | .field i => Json.mkObj [("field", i)]
  | .lit v => litJson float v
  | .un f a => Json.mkObj ([("fn", Json.str (unName f)), ("args", Json.arr #[exprJson float a])] ++
      match f with | .raise m => [("message", Json.str m)] | _ => [])
  | .bin f a b => Json.mkObj [("fn", Json.str (binName f)),
      ("args", Json.arr #[exprJson float a, exprJson float b])]
  | .ifThen c t e => Json.mkObj [("if", exprJson float c), ("then", exprJson float t),
      ("else", exprJson float e)]
  | .hof .. => Json.mkObj [("unsupported", "a higher-order function")]

/-- The constructs whose entries may differ from the native call. -/
def unFns : List UnFn :=
  FMath.all.map .fmath ++
    [OverflowMode.silent, .saturate].flatMap fun m => [IntWidth.i8, .i16, .i32, .i64].map (.fit m)

def binFns : List BinFn :=
  [.fadd, .fsub, .fmul, .fdiv, .fmod, .fpow, .fatan2, .idiv, .imod] ++
    [BitOp.and, .or, .xor, .shl, .shr].map .bit

def floatUn : UnFn → Bool | .fmath _ => true | _ => false
def floatBin : BinFn → Bool
  | .fadd | .fsub | .fmul | .fdiv | .fmod | .fpow | .fatan2 => true
  | _ => false

/-- The entries of a table that are not the native call. -/
def tableJson {p : Profile} (L : Lowering p) : Json :=
  let un := unFns.filterMap fun f => (L.un f).bind fun e =>
    let native := Expr.un f (.field 0)
    if e.tmpl == native then none
    else some (Json.mkObj [("fn", Json.str (unName f)), ("arity", (1 : Nat)),
      ("template", exprJson (floatUn f) e.tmpl)])
  let bin := binFns.filterMap fun f => (L.bin f).bind fun e =>
    let native := Expr.bin f (.field 0) (.field 1)
    if e.tmpl == native then none
    else some (Json.mkObj [("fn", Json.str (binName f)), ("arity", (2 : Nat)),
      ("template", exprJson (floatBin f) e.tmpl)])
  Json.arr (un ++ bin).toArray

end LoweringExport

/-- The DuckDB table, exported. `"on"` names the setting of
`error_on_division_by_zero` it is for (`sverify.sql.lowering.SETTING`). -/
def Lowering.duckdbTableJson : Lean.Json :=
  Lean.Json.mkObj [("on", LoweringExport.tableJson duckdbOn)]

/-- The generated lowering to DuckDB under its default settings. -/
def Lowering.duckdb : Lowering (Profile.duckdb {}) := duckdbOn

theorem Lowering.duckdb_total : Lowering.duckdb.Total := duckdbOn.total

/-- **Every lowered expression is exact on DuckDB.** -/
theorem Lowering.duckdb_exact (e : Expr) :
    Expr.Exact (Profile.duckdb {}) (Lowering.duckdb.lowerE e) e :=
  Lowering.lowerE_exact Lowering.duckdb_total e

/-- **The lowered plan runs correctly on DuckDB, or raises.** Unless one of
its expressions raises on a row DuckDB evaluates it on, DuckDB's functions
give `Rel.eval`'s rows, on every catalog, under DuckDB's default settings: no
contract and no guard elimination needed. Trusted, as for `Rel.duckdb_sound`:
that `Profile.duckdb` is DuckDB's, and that the SQL printer is faithful. -/
theorem Rel.duckdb_shim_sound {cat : Catalog} {r : Rel}
    (h : ¬(Lowering.duckdb.lowerRel r).Raises (Profile.duckdb {}) cat) :
    (Lowering.duckdb.lowerRel r).evalI (Profile.duckdb {}).impl cat = r.eval cat :=
  Lowering.lowerRel_sound Lowering.duckdb_total h

end Substrait
