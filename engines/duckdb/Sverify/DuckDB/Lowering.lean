import Sverify.Engines.LoweringHint
import Sverify.Engines.LoweringExport
import Sverify.DuckDB.LoweringOn.Table
import Sverify.DuckDB.LoweringOn.Guards
import Sverify.Core.Allowed

/-!
# The generated lowering to DuckDB (#241)

The table for DuckDB's profile under its default settings
(`error_on_division_by_zero` and `ieee_floating_point_ops` on), `duckdbOn`, is
generated: the search (`generate_lowering`, `engines/Sverify/Engines/LoweringSearch.lean`)
runs in `scripts/RegenLowering.lean` (`poe regen-lowering`) and writes each
entry it found, with its proof, to `engines/duckdb/Sverify/DuckDB/LoweringOn`, one
module per area, which a build checks in parallel without searching
(`engines/Sverify/Engines/Generated.lean`). Other settings have no table: sverify runs
DuckDB with its defaults, and the SQL it writes for DuckDB assumes them (#241). Where
DuckDB differs from the reference (FACTS R15), an entry is a guard that
raises where the reference does, or `MIN % -1` and `<<` as the reference
computes them; elsewhere the native function.

Its correctness (`Lowering.duckdb_exact`, `Rel.duckdb_shim_sound`) follows
from the generic theorems of `engines/Sverify/Engines/Lowering.lean`. `duckdbOn.coverage`
lists how each construct is lowered; the golden test
`tests/lowering/duckdb.expected` records them (`substrait-check
--lowering-coverage`), so a change to the generator's output shows in review.
-/

namespace Substrait

/-- A new `engines/duckdb/Sverify/DuckDB/LoweringCache.lean` from this build's coverage
(`substrait-check --lowering-cache`): each construct's template as the report
prints it, or, where none was found, why (the breadcrumb). -/
def loweringCacheSource : String :=
  let entry (table : String) (row : String × String × Nat) : String :=
    let (construct, how, _) := row
    let found := !how.startsWith "missing"
    let template := if found then how else ""
    let note := if found then "" else how
    s!"  \{ table := {repr table}, construct := {repr construct},\n    template := {repr template}, note := {repr note} }"
  let rows := duckdbOn.coverage.map (entry "duckdbOn")
  "import Sverify.Engines.LoweringHint\n\n/-!\n# The lowering generator's cache (#241, #242)\n\n" ++
  "Generated by `substrait-check --lowering-cache` from a build's coverage: do not\n" ++
  "edit. To regenerate, run\n" ++
  "`.lake/build/bin/substrait-check --lowering-cache > engines/duckdb/Sverify/DuckDB/LoweringCache.lean`\n" ++
  "after a build. See `engines/Sverify/Engines/LoweringHint.lean`.\n-/\n\nnamespace Substrait\n\n" ++
  "def loweringCache : List LoweringHint := [\n" ++ ",\n".intercalate rows ++ "\n]\n\nend Substrait\n"


variable [Boxes.Ambient]
/-- The DuckDB table, exported. `"on"` names the setting of
`error_on_division_by_zero` it is for (`sverify.sql.lowering.SETTING`). -/
def Lowering.duckdbTableJson : Lean.Json :=
  Lean.Json.mkObj [("on", LoweringExport.tableJson duckdbOn), ("floor", LoweringExport.floorJson),
    -- A decimal cast to an integer: one template at every scale (`Lowering.dtruncEntry`),
    -- its `x − x % 10ᵏ` rendered `trunc(x)` (duckdb-decimal-trunc, ruling 284 as amended).
    ("dtrunc", Lean.Json.mkObj [("template", LoweringExport.exprJson (Lowering.dtruncTemplate 0)),
      ("renders", Lean.Json.str "trunc")])]

/-- The generated lowering to DuckDB under its default settings. -/
def Lowering.duckdb : Lowering (Profile.duckdb {}) := duckdbOn

theorem Lowering.duckdb_total : Lowering.duckdb.Total := duckdbOn.total
theorem Lowering.duckdb_allExact : Lowering.duckdb.AllExact := duckdbOn.allExact
theorem Lowering.duckdb_noneOnDbl : Lowering.duckdb.NoneOnDbl := duckdbOn.noneOnDbl

/-- **Every lowered expression is exact on DuckDB.** -/
theorem Lowering.duckdb_exact (e : Expr) :
    Expr.Exact (Profile.duckdb {}) (Lowering.duckdb.lowerE e) e :=
  Lowering.lowerE_exact Lowering.duckdb_total Lowering.duckdb_noneOnDbl e

/-- **The lowered plan runs correctly on DuckDB, or raises.** Unless one of
its expressions raises on a row DuckDB evaluates it on, DuckDB's functions
give `Rel.eval`'s rows, on every catalog, under DuckDB's default settings: no
contract and no guard elimination needed. Trusted, as for `Rel.duckdb_sound`:
that `Profile.duckdb` is DuckDB's, and that the SQL printer is faithful. -/
theorem Rel.duckdb_shim_sound {cat : Catalog} {r : Rel}
    (h : ¬(Lowering.duckdb.lowerRel r).Raises (Profile.duckdb {}) cat) :
    (Lowering.duckdb.lowerRel r).eval cat (Profile.duckdb {}).impl = r.eval cat :=
  Lowering.lowerRel_sound Lowering.duckdb_total Lowering.duckdb_noneOnDbl h

/-- The DuckDB shim: unless the shimmed plan raises, DuckDB returns an allowed
result. -/
theorem Rel.duckdb_shim_allowed {cat : Catalog} {r : Rel}
    (h : ¬(Lowering.duckdb.lowerRel r).Raises (Profile.duckdb {}) cat) :
    r.Allowed cat ((Lowering.duckdb.lowerRel r).eval cat (Profile.duckdb {}).impl) := by
  rw [Rel.duckdb_shim_sound h]; exact r.eval_allowed cat

/-- Every guard of DuckDB's table is exact: a writer may drop them all. -/
theorem Lowering.duckdb_guardsFor_none : Lowering.duckdb.GuardsFor fun _ => false :=
  duckdbOn.guardsFor_none

/-- **DuckDB's SQL without guards** (`to_sql(…, guards=False)`, whose templates
`sverify.sql.lowering.render` writes with their `raise` arms left out): where
`Rel.mayIssues` reports only assumed issues (`guard_free`), on a catalog that
satisfies the preconditions, DuckDB's functions give `Rel.eval`'s rows, or
the plan raises. Trusted, as for `Rel.duckdb_shim_sound`: that
`Profile.duckdb` is DuckDB's, and that the SQL printer is faithful. -/
theorem Rel.duckdb_guardFree_sound {cat : Catalog} (hcat : cat.WF) {A : String → List AVal}
    {F : String → List Fact}
    (hA : ∀ t, ∀ row ∈ (cat t).rows, EnvMem (A t) row)
    (hF : ∀ t, ∀ row ∈ (cat t).rows, FactsHold (F t) row) {T : WindowKeys} (hT : T.SoundAll cat)
    {r : Rel} (hwf : r.WF cat) (hsmall : r.Small cat) (hs : r.looseSub = true)
    (hm : (r.mayIssues cat A F T false).all (·.1.assumed) = true)
    (h : ¬(Lowering.duckdb.lowerRelWith (fun _ => false) r).Raises (Profile.duckdb {}) cat) :
    (Lowering.duckdb.lowerRelWith (fun _ => false) r).eval cat (Profile.duckdb {}).impl = r.eval cat :=
  Lowering.lowerRelWith_mayIssues_sound Lowering.duckdb_total Lowering.duckdb_allExact
    Lowering.duckdb_noneOnDbl Lowering.duckdb_guardsFor_none hcat hA hF
    hT hwf hsmall hs (by simpa using hm) h

-- The table's decimal casts to an integer are `Lowering.dtruncEntry`'s template at each
-- scale, the one the export renders (ruling 290's P4): a regeneration that drops
-- `excluding [.., UnFn.dtrunc]` (`scripts/RegenLowering.lean`) fails here.
#guard letI := Boxes.Ambient.none
  [0, 1, 2, 18, 19, 37, 38].all fun k =>
    (Lowering.duckdb.un (.dtrunc k)).any (·.tmpl == Lowering.dtruncTemplate k)

end Substrait
