/-- **Every guard of the table is exact** (`Lowering.GuardsFor`): a writer may drop them all. -/
theorem Substrait.duckdbOn.guardsFor_none : (Substrait.duckdbOn).GuardsFor fun _ => false :=
  ⟨fun f en h => by have g := Substrait.duckdbOn.guardsUn f; rw [h] at g; exact g,
   fun f en h => by have g := Substrait.duckdbOn.guardsBin f; rw [h] at g; exact g⟩
